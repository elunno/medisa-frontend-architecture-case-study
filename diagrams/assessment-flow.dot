digraph G {
graph [bgcolor="#FFFFFF", pad="0.2", nodesep="0.45", ranksep="0.55"]; node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontname="Arial", fontsize=11, margin="0.12,0.08"]; edge [color="#64748B", arrowsize=0.7, fontname="Arial", fontsize=9];
rankdir=LR;
definition [label="Assessment Definition\nquestions · options · bands"];
runner [label="Runner\nstep · answers · validation"];
evaluator [label="Evaluator\nscore · interpret"];
result [label="Normalized Result"];
presentation [label="Result UI\ntext · chart · recommendations"];
definition -> runner;
runner -> evaluator [label="submit answers"];
definition -> evaluator;
evaluator -> result -> presentation;
}
