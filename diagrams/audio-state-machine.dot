digraph G {
graph [bgcolor="#FFFFFF", pad="0.2", nodesep="0.45", ranksep="0.55"]; node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontname="Arial", fontsize=11, margin="0.12,0.08"]; edge [color="#64748B", arrowsize=0.7, fontname="Arial", fontsize=9];
rankdir=LR;
idle [label="IDLE"];
loading [label="LOADING"];
playing [label="PLAYING", fillcolor="#ECFDF5"];
paused [label="PAUSED"];
finished [label="FINISHED"];
error [label="ERROR", fillcolor="#FEF2F2"];
idle -> loading [label="load(track)"];
loading -> playing [label="ready"];
loading -> error [label="failure"];
playing -> paused [label="pause"];
paused -> playing [label="play"];
playing -> finished [label="ended"];
playing -> error [label="failure"];
paused -> loading [label="load(new track)"];
playing -> loading [label="load(new track)"];
finished -> playing [label="play/restart"];
error -> loading [label="retry/new track"];
}
