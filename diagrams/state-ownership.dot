digraph G {
graph [bgcolor="#FFFFFF", pad="0.2", nodesep="0.45", ranksep="0.55"]; node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontname="Arial", fontsize=11, margin="0.12,0.08"]; edge [color="#64748B", arrowsize=0.7, fontname="Arial", fontsize=9];
rankdir=TB;
server [label="Server State\ncontent · professionals · availability · subscription"];
query [label="Query / Cache Layer"];
app [label="Application State\naudio runtime · identity bootstrap"];
workflow [label="Workflow State\nbooking · mood · assessment"];
local [label="Local UI State\nmodal · transient input"];
server -> query;
query -> app [style=dashed, label="consume, don't blindly mirror"];
app -> workflow [style=dashed, label="context"];
workflow -> local [style=dashed, label="presentation"];
}
