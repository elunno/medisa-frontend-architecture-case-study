digraph G {
graph [bgcolor="#FFFFFF", pad="0.2", nodesep="0.45", ranksep="0.55"]; node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontname="Arial", fontsize=11, margin="0.12,0.08"]; edge [color="#64748B", arrowsize=0.7, fontname="Arial", fontsize=9];
rankdir=LR;
request [label="User requests resource"];
resolver [label="Entitlement Resolver\nidentity + subscription + policy + time"];
allow [label="Allow\nOpen feature", fillcolor="#ECFDF5"];
signin [label="Sign in", fillcolor="#FFF7ED"];
upgrade [label="Upgrade / Renew", fillcolor="#FFF7ED"];
unavailable [label="Unavailable", fillcolor="#FEF2F2"];
request -> resolver;
resolver -> allow [label="allowed"];
resolver -> signin [label="anonymous"];
resolver -> upgrade [label="subscription required/expired"];
resolver -> unavailable [label="policy denies"];
}
